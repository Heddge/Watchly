
<div class="catalog-page">
  <div class="catalog-header">
    <div>
      <p class="catalog-eyebrow">YOUR ENTERTAINMENT LIBRARY</p>
      <h1>Movie Catalog</h1>
      <p class="catalog-subtitle">Discover your next favorite movie.</p>
    </div>

    <span class="catalog-count">
      <%= @items.count %> movies
    </span>
  </div>

  <%= form_with url: items_path, method: :get, local: true, class: "catalog-search" do |form| %>
    <%= form.text_field :q, value: @query, placeholder: "Search movies by title..." %>
    <%= form.submit "Search" %>
  <% end %>

  <% if @items.any? %>
    <div class="movie-grid">
      <% @items.each do |item| %>
        <article class="movie-card">
          <% if item.poster_path.present? %>
            <%= image_tag(
                "https://image.tmdb.org/t/p/w500#{item.poster_path}",
                alt: "#{item.title} poster",
                class: "movie-poster",
                loading: "lazy"
            ) %>
            <% else %>
            <div class="movie-card-placeholder">NO POSTER</div>
            <% end %>

          <div class="movie-card-content">
            <h2><%= link_to item.title, item_path(item) %></h2>
            <p class="movie-year"><%= item.release_year %></p>

            <% if item.description.present? %>
              <p class="movie-description">
                <%= truncate(item.description, length: 140) %>
              </p>
            <% else %>
              <p class="movie-description">No description available.</p>
            <% end %>

            <%= link_to "View details", item_path(item), class: "movie-details-link" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="catalog-empty">
      <h2>No movies found</h2>
      <p>Try another title.</p>
    </div>
  <% end %>
</div>
