
<div class="dashboard-page dashboard-layout">
  <div class="dashboard-main-column">
  <section class="dashboard-search">
    <%= form_with url: items_path, method: :get, local: true,
                  class: "dashboard-search-form" do |form| %>
      <span class="dashboard-search-icon">⌕</span>
      <%= form.search_field :q,
          placeholder: "Поиск фильмов по названию...",
          value: params[:q],
          aria: { label: "Поиск фильмов" } %>
      <%= form.submit "Найти", class: "dashboard-search-button" %>
    <% end %>
  </section>

  <section class="dashboard-welcome">
    <div>
      <p class="dashboard-eyebrow">ТВОЁ КИНОПРОСТРАНСТВО</p>
      <h1>
        Привет<%= ", #{current_user.username}" if current_user %>!
      </h1>
      <p>Здесь ты найдёшь рекомендации, свою библиотеку и статистику.</p>
    </div>
  </section>

  <section class="dashboard-section">
    <div class="dashboard-section-heading">
      <div>
        <h2>Рекомендации</h2>
        <p>Популярные фильмы с высоким рейтингом</p>
      </div>
      <%= link_to "Весь каталог →", items_path, class: "dashboard-text-link" %>
    </div>

    <% if @top_movies.any? %>
      <div class="recommendation-row">
        <% @top_movies.each do |item| %>
          <article class="recommendation-card">
            <%= link_to item_path(item), class: "recommendation-poster-link" do %>
              <% if item.poster_path.present? %>
                <%= image_tag(
                  "https://image.tmdb.org/t/p/w500#{item.poster_path}",
                  alt: item.title,
                  class: "recommendation-poster",
                  loading: "lazy"
                ) %>
              <% else %>
                <div class="recommendation-poster-placeholder">
                  <span>Нет постера</span>
                </div>
              <% end %>
            <% end %>

            <div class="recommendation-info">
              <h3><%= link_to item.title, item_path(item) %></h3>
              <p><%= item.release_year || "Год неизвестен" %></p>
              <span class="recommendation-rating">
                ★ <%= number_with_precision(item.tmdb_rating, precision: 1) %>
              </span>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="dashboard-empty">Фильмы пока не загружены.</div>
    <% end %>
  </section>

  <section class="dashboard-section dashboard-library-section">
    <div class="dashboard-section-heading">
      <div>
        <h2>Моя библиотека</h2>
        <p>Твои фильмы, статусы просмотра и оценки</p>
      </div>
      <% if current_user %>
        <%= link_to "Открыть библиотеку →", user_items_path,
            class: "dashboard-text-link" %>
      <% end %>
    </div>

    <% if !current_user %>
      <div class="dashboard-empty">
        <p>Войди в аккаунт, чтобы собирать собственную библиотеку фильмов.</p>
        <%= link_to "Войти", "/login", class: "dashboard-primary-button" %>
      </div>
    <% elsif @user_items.any? %>
      <div class="dashboard-table-wrap">
        <table class="dashboard-table">
          <thead>
            <tr>
              <th>Фильм</th>
              <th>Жанр</th>
              <th>Статус</th>
              <th>Моя оценка</th>
            </tr>
          </thead>
          <tbody>
            <% @user_items.each do |user_item| %>
              <% item = user_item.item %>
              <tr>
                <td>
                  <div class="dashboard-table-movie">
                    <% if item.poster_path.present? %>
                      <%= image_tag(
                        "https://image.tmdb.org/t/p/w92#{item.poster_path}",
                        alt: "",
                        class: "dashboard-table-poster",
                        loading: "lazy"
                      ) %>
                    <% else %>
                      <div class="dashboard-table-poster-placeholder">🎬</div>
                    <% end %>
                    <div>
                      <%= link_to item.title, item_path(item),
                          class: "dashboard-table-title" %>
                      <span class="dashboard-table-year">
                        <%= item.release_year || "Год неизвестен" %>
                      </span>
                    </div>
                  </div>
                </td>
                <td class="dashboard-table-muted">
                  <%= item.genres.map(&:name).first(2).join(", ").presence || "—" %>
                </td>
                <td>
                  <% status_labels = {
                    "want" => "В планах",
                    "in_progress" => "Смотрю",
                    "completed" => "Просмотрен"
                  } %>
                  <span class="dashboard-status status-<%= user_item.status %>">
                    <%= status_labels[user_item.status] || user_item.status.humanize %>
                  </span>
                </td>
                <td>
                  <% if user_item.rating.present? %>
                    <span class="dashboard-personal-rating">
                      ★ <%= user_item.rating %>/10
                    </span>
                  <% else %>
                    <span class="dashboard-table-muted">Не оценён</span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="dashboard-empty">
        <p>Здесь пока пусто. Добавь первый фильм из каталога.</p>
        <%= link_to "Перейти в каталог", items_path,
            class: "dashboard-primary-button" %>
      </div>
        <% end %>
  </section>
  </div>

  <aside class="dashboard-right-column">
    <section class="dashboard-panel">
      <div class="dashboard-panel-heading">
        <h2>Моя статистика</h2>
      </div>

      <% if current_user %>
        <div class="dashboard-stats-grid">
          <div class="dashboard-stat-card">
            <span class="dashboard-stat-icon">▤</span>
            <span class="dashboard-stat-value"><%= @total_movies %></span>
            <span class="dashboard-stat-label">В библиотеке</span>
          </div>

          <div class="dashboard-stat-card">
            <span class="dashboard-stat-icon">✓</span>
            <span class="dashboard-stat-value"><%= @completed_movies %></span>
            <span class="dashboard-stat-label">Просмотрено</span>
          </div>

          <div class="dashboard-stat-card">
            <span class="dashboard-stat-icon">★</span>
            <span class="dashboard-stat-value"><%= @rated_movies %></span>
            <span class="dashboard-stat-label">Оценено</span>
          </div>

          <div class="dashboard-stat-card">
            <span class="dashboard-stat-icon">✦</span>
            <span class="dashboard-stat-value">
              <%= @average_personal_rating || "—" %>
            </span>
            <span class="dashboard-stat-label">Средняя оценка</span>
          </div>
        </div>
      <% else %>
        <p class="dashboard-panel-message">
          Войди в аккаунт, чтобы увидеть свою статистику.
        </p>
        <%= link_to "Войти", "/login", class: "dashboard-primary-button" %>
      <% end %>
    </section>

    <section class="dashboard-panel dashboard-recent-panel">
      <div class="dashboard-panel-heading">
        <h2>Недавно добавлено</h2>
        <% if current_user && @total_movies.positive? %>
          <%= link_to "Все →", user_items_path, class: "dashboard-text-link" %>
        <% end %>
      </div>

      <% if current_user && @recent_user_items.any? %>
        <div class="dashboard-recent-list">
          <% @recent_user_items.each do |user_item| %>
            <% item = user_item.item %>

            <%= link_to item_path(item), class: "dashboard-recent-item" do %>
              <% if item.poster_path.present? %>
                <%= image_tag(
                  "https://image.tmdb.org/t/p/w92#{item.poster_path}",
                  alt: "",
                  class: "dashboard-recent-poster",
                  loading: "lazy"
                ) %>
              <% else %>
                <div class="dashboard-recent-poster dashboard-recent-placeholder">🎬</div>
              <% end %>

              <div class="dashboard-recent-info">
                <span class="dashboard-recent-title"><%= item.title %></span>
                <span class="dashboard-recent-year">
                  <%= item.release_year || "Год неизвестен" %>
                </span>
              </div>

              <% if user_item.rating.present? %>
                <span class="dashboard-recent-rating">
                  <%= user_item.rating %><small>/10</small>
                </span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      <% elsif current_user %>
        <p class="dashboard-panel-message">
          Здесь появятся фильмы, которые ты добавишь в библиотеку.
        </p>
        <%= link_to "Найти фильмы", items_path, class: "dashboard-text-link" %>
      <% else %>
        <p class="dashboard-panel-message">
          Войди в аккаунт, чтобы видеть последние добавления.
        </p>
      <% end %>
    </section>
  </aside>
</div>
